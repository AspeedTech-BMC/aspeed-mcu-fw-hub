module(name = "aspeed_build")

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_shell", version = "0.6.1")

_local_repo = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:local.bzl",
    "new_local_repository",
)

# Zephyr: track all source directories, exclude build outputs and git metadata
_local_repo(
    name = "zephyr_ws",
    path = "zephyr-workspace",
    build_file_content = """
filegroup(
    name = "all",
    srcs = glob([
        "aspeed-zephyr-project/**",
        "zephyr/**",
        "modules/**",
        "bootloader/**",
        "middlewares/**",
        ".west/config",
    ], exclude = ["**/.git/**", "build/**"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "pfr_pldm_fwu_pkg_v1_tool",
    srcs = ["aspeed-zephyr-project/apps/aspeed-pfr/tools/pldm-fwu-pkg/img.py"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "ast1080_dcscm_bhs_pldm_config",
    srcs = ["aspeed-zephyr-project/apps/aspeed-pfr/boards/ast1080_dcscm_bhs.conf"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "ast1080_dcscm_oks_pldm_config",
    srcs = ["aspeed-zephyr-project/apps/aspeed-pfr/boards/ast1080_dcscm_oks.conf"],
    visibility = ["//visibility:public"],
)
""",
)

# caliptra-mcu-sw: track only Cargo files and source, exclude build artifacts
_local_repo(
    name = "caliptra_mcu_sw",
    path = "caliptra-mcu-sw",
    build_file_content = """
filegroup(
    name = "all",
    srcs = glob(
        ["**"],
        exclude = ["**/.git/**", "target/**"],
    ),
    visibility = ["//visibility:public"],
)
""",
)

_local_repo(
    name = "cptra_imgtool",
    path = "cptra_imgtool",
    build_file_content = """
filegroup(
    name = "all",
    srcs = glob(
        ["**"],
        exclude = ["**/.git/**", "target/**", "out/**"],
    ),
    visibility = ["//visibility:public"],
)
""",
)

# bmc-pb: only pre-built binaries
_local_repo(
    name = "bmc_pb",
    path = "bmc-pb",
    build_file_content = """
filegroup(
    name = "all",
    srcs = glob(["**/*.bin"], exclude = ["**/.git/**"]),
    visibility = ["//visibility:public"],
)
""",
)

_git_repo = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:git.bzl",
    "git_repository",
)

# QEMU: fetched (not manually cloned) and pinned to a fixed commit, so
# "bazel build //qemu:dist" alone is enough to get the source. Bump
# QEMU_COMMIT to move to a different upstream revision; add patch labels to
# QEMU_PATCHES as they are added under qemu/patches/.
QEMU_REMOTE = "https://github.com/qemu/qemu.git"
QEMU_COMMIT = "5ef0ecc5942ee07bb581cc96a97bbfc0fdf4005c"
QEMU_PATCHES = [
    "//qemu:patches/0001-hw-arm-aspeed_ast1040-Support-FMC-stub-SPI-ast1080.patch",
    "//qemu:patches/v1-0002-hw-arm-aspeed_ast1040-Add-unimplemented-swmbx-stub.patch",
    "//qemu:patches/v1-0003-hw-arm-aspeed_ast1040-Add-unimplemented-i3c-stub.patch",
]

_git_repo(
    name = "qemu_src",
    remote = QEMU_REMOTE,
    commit = QEMU_COMMIT,
    patches = QEMU_PATCHES,
    patch_args = ["-p1"],
    build_file_content = """
exports_files(["configure"])

filegroup(
    name = "all",
    srcs = glob(["**"], exclude = ["**/.git/**", "_bazel_build/**"]),
    visibility = ["//visibility:public"],
)
""",
)
