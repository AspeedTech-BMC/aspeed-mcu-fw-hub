load("//bazel:caliptra.bzl", "caliptra_targets")
load("//bazel:bmc_pb.bzl", "bmc_pb_target")

_RISCV = "target/riscv32imc-unknown-none-elf/release"

bmc_pb_target(pb = [
    "ast1040a0/boomcu-rom-xip.bin",
    "ast1040a0/caliptra-fw.bin",
    "ast1040a0/ssmcu-rom-xip.bin",
])

caliptra_targets(
    platform = "ast1040",
    ssmcu_runtime_bin = "{}/runtime-ast1040.bin".format(_RISCV),
    ssmcu_runtime_out = "ssmcu-runtime.bin",
)
