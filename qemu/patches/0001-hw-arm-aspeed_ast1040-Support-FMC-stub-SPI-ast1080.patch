     object_initialize_child(obj, "jtag[1]", &s->jtag[1],
@@ -267,6 +277,41 @@ static void aspeed_soc_ast1040_realize(DeviceState *dev_soc, Error **errp)
         aspeed_mmio_map(s->memory, SYS_BUS_DEVICE(&s->wdt[i]), 0, wdt_offset);
     }

+    /* FMC, The number of CS is set at the board level */
+    object_property_set_link(OBJECT(&s->fmc), "dram", OBJECT(&s->sram[1]),
+            &error_abort);
+    if (!sysbus_realize(SYS_BUS_DEVICE(&s->fmc), errp)) {
+        return;
+    }
+    aspeed_mmio_map(s->memory, SYS_BUS_DEVICE(&s->fmc), 0,
+                    sc->memmap[ASPEED_DEV_FMC]);
+    aspeed_mmio_map(s->memory, SYS_BUS_DEVICE(&s->fmc), 1,
+                    ASPEED_SMC_GET_CLASS(&s->fmc)->flash_window_base);
+    sysbus_connect_irq(SYS_BUS_DEVICE(&s->fmc), 0,
+                       aspeed_soc_ast1040_get_irq(s, ASPEED_DEV_FMC));
+
+    /* SPI0/SPI1 controller regs: cs-group-analog-mux-enable boards (e.g.
+     * ast1080_dcscm) alias CS0/CS1 and CS2/CS3 onto the same pins via an
+     * analog mux, so the same flash window is legitimately programmed with
+     * overlapping segments for different CS groups. The real aspeed.smc
+     * model doesn't understand that and treats it as an invalid/overlapping
+     * segment, wedging the boot before any console output. Stub these out
+     * as unimplemented_device until the model (or the mux modeling) catches
+     * up - FMC (above) is unaffected and stays on the real model.
+     */
+    aspeed_mmio_map_unimplemented(s->memory, SYS_BUS_DEVICE(&s->spi0_ctrl),
+                                  "aspeed.spi0_ctrl",
+                                  sc->memmap[ASPEED_DEV_SPI0], 0x300);
+    aspeed_mmio_map_unimplemented(s->memory, SYS_BUS_DEVICE(&s->spi1_ctrl),
+                                  "aspeed.spi1_ctrl",
+                                  sc->memmap[ASPEED_DEV_SPI1], 0x300);
+    aspeed_mmio_map_unimplemented(s->memory, SYS_BUS_DEVICE(&s->spi0_mmap),
+                                  "aspeed.spi0_mmap",
+                                  0xA0000000, 0x10000000);
+    aspeed_mmio_map_unimplemented(s->memory, SYS_BUS_DEVICE(&s->spi1_mmap),
+                                  "aspeed.spi1_mmap",
+                                  0xC0000000, 0x10000000);
+
     /* Unimplemented peripherals */
     aspeed_mmio_map_unimplemented(s->memory, SYS_BUS_DEVICE(&s->pwm),
                                   "aspeed.pwm",
@@ -309,6 +354,7 @@ static void aspeed_soc_ast1040_class_init(ObjectClass *klass, const void *data)
     sc->uarts_num       = 13;
     sc->sgpio_num       = 2;
     sc->wdts_num        = 8;
+    sc->spis_num        = 2;
     sc->uarts_base      = ASPEED_DEV_UART0;
     sc->irqmap          = aspeed_soc_ast1040_irqmap;
     sc->memmap          = aspeed_soc_ast1040_memmap;
