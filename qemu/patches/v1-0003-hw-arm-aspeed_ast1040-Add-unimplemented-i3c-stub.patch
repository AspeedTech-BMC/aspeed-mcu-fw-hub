From: Steven Lee <steven_lee@aspeedtech.com>
Subject: [PATCH v1] hw/arm/aspeed_ast1040: Add unimplemented i3c0/i3c3 stubs

The AST1080 DCSCM BHS/OKS boards now enable i3c0 and i3c3 (MCTP over
I3C to the BMC) in the Zephyr devicetree. QEMU has no Aspeed I3C
model, so guest accesses to i3c0 (0x74c20000) / i3c3 (0x74c23000) hit
the unassigned-memory handler and bus-fault instead of a normal MMIO
access.

Back both with an unimplemented_device stub, same as swmbx/i2c_filter/
spim, so accesses log via "-d unimp" and return 0 instead of faulting.

Signed-off-by: Steven Lee <steven_lee@aspeedtech.com>
---
 include/hw/arm/aspeed_soc.h |  2 ++
 hw/arm/aspeed_ast1040.c     | 10 ++++++++++
 2 files changed, 12 insertions(+)

diff --git a/include/hw/arm/aspeed_soc.h b/include/hw/arm/aspeed_soc.h
index f6a7b8c..e4f5a6b 100644
--- a/include/hw/arm/aspeed_soc.h
+++ b/include/hw/arm/aspeed_soc.h
@@ -117,6 +117,8 @@
     UnimplementedDeviceState swmbx;
     UnimplementedDeviceState i2c_filter;
     UnimplementedDeviceState spim;
+    UnimplementedDeviceState i3c0;
+    UnimplementedDeviceState i3c3;
     UnimplementedDeviceState jtag[ASPEED_JTAG_NUM];
     AspeedAPB2OPBState fsi[2];
     AspeedLTPIState ltpi_ctrl[ASPEED_IOEXP_NUM];
diff --git a/hw/arm/aspeed_ast1040.c b/hw/arm/aspeed_ast1040.c
index c9d0e1f..7c8d9e1 100644
--- a/hw/arm/aspeed_ast1040.c
+++ b/hw/arm/aspeed_ast1040.c
@@ -139,6 +139,8 @@ static void aspeed_soc_ast1040_init(Object *obj)
     object_initialize_child(obj, "i2c_filter", &s->i2c_filter,
                             TYPE_UNIMPLEMENTED_DEVICE);
     object_initialize_child(obj, "spim", &s->spim, TYPE_UNIMPLEMENTED_DEVICE);
+    object_initialize_child(obj, "i3c0", &s->i3c0, TYPE_UNIMPLEMENTED_DEVICE);
+    object_initialize_child(obj, "i3c3", &s->i3c3, TYPE_UNIMPLEMENTED_DEVICE);
     object_initialize_child(obj, "jtag[0]", &s->jtag[0],
                             TYPE_UNIMPLEMENTED_DEVICE);
     object_initialize_child(obj, "jtag[1]", &s->jtag[1],
@@ -322,6 +324,14 @@ static void aspeed_soc_ast1040_realize(DeviceState *dev_soc, Error **errp)
                                   "aspeed.spim",
                                   0x74c15000, 0x3000);

+    /* MCTP over I3C (i3c0/i3c3): real HW address, no QEMU model yet */
+    aspeed_mmio_map_unimplemented(s->memory, SYS_BUS_DEVICE(&s->i3c0),
+                                  "aspeed.i3c0",
+                                  0x74c20000, 0x1000);
+    aspeed_mmio_map_unimplemented(s->memory, SYS_BUS_DEVICE(&s->i3c3),
+                                  "aspeed.i3c3",
+                                  0x74c23000, 0x1000);
+
     /* Unimplemented peripherals */
     aspeed_mmio_map_unimplemented(s->memory, SYS_BUS_DEVICE(&s->pwm),
                                   "aspeed.pwm",
